{
  "manifest_version": 3,
  "name": "Youbefy",
  "description": "Convert your Spotify playlists into YouTube playlists in one click.",
  "version": "0.2.0",
  "action": {
    "default_title": "Youbefy",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "identity",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://www.youtube.com/*",
    "https://*.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/playlist/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
